{
    // Configures the C/C++ extension (IntelliSense) so the sources do not show
    // "cannot open source file vulkan/vulkan.h".
    //
    // The MSVC generator cannot emit compile_commands.json, so the include paths
    // are listed explicitly. GLFW lives under build/ because it is fetched by
    // CMake; VULKAN_SDK is a machine-level environment variable set by the
    // Vulkan SDK installer (restart VS Code if it resolves to nothing).
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/_deps/glfw-src/include",
                "${env:VULKAN_SDK}/Include"
            ],
            "defines": [
                "NOMINMAX",
                "WIN32_LEAN_AND_MEAN"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        },
        {
            // The C/C++ extension picks the configuration whose name matches the
            // host, so these are selected automatically off Windows.
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/_deps/glfw-src/include"
            ],
            "defines": [],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            // Ninja and Makefile builds export this (CMAKE_EXPORT_COMPILE_COMMANDS),
            // so the Vulkan include path comes from the build rather than being
            // spelled out here.
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        },
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/_deps/glfw-src/include"
            ],
            "defines": [],
            "cStandard": "c17",
            "cppStandard": "c++20",
            // Use macos-clang-x64 instead on an Intel Mac.
            "intelliSenseMode": "macos-clang-arm64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ]
}
